        <munit:execution>

            <munit:set-event doc:name="Set Valid Contact Creation Request">

                <munit:payload
                    mediaType="application/json"
                    value="#[output application/json
---
{
    firstName: 'John',
    lastName: 'Doe',
    email: 'john.doe@example.com',
    accountId: '001000000000001AAA'
}]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Post Contacts Flow"
