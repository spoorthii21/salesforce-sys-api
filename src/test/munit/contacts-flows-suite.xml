<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="contacts-flows-suite.xml"/>


    <!-- ========================================================= -->
    <!-- TEST 01: POST CONTACT SUCCESS                             -->
    <!-- ========================================================= -->

    <munit:test
        name="post-contacts-success-test"
        description="Verify successful Salesforce Contact creation">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce Contact Creation Success"
                processor="salesforce:create">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Create Salesforce Contact"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[{
                            successful: true,
                            items: [
                                {
                                    id: '003000000000001AAA',
                                    payload: {
                                        success: true,
                                        errors: []
                                    },
                                    successful: true
                                }
                            ]
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Valid Contact Creation Request">

                <munit:payload
                    mediaType="application/json"
                    value="#[output application/json
---
{
    firstName: 'John',
    lastName: 'Doe',
    email: 'john.doe@example.com',
    accountId: '001000000000001AAA'
}]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Post Contacts Flow"
                name="post:\contacts:application\json:salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Contact Creation Status Success"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Creation Message"
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('Contact created successfully')]"/>

            <munit-tools:assert-that
                doc:name="Assert Created Contact ID"
                expression="#[payload.id]"
                is="#[MunitTools::equalTo('003000000000001AAA')]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Contact Creation Called Once"
                processor="salesforce:create"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Create Salesforce Contact"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


    <!-- ========================================================= -->
    <!-- TEST 02: POST CONTACT BUSINESS FAILURE                    -->
    <!-- ========================================================= -->

    <munit:test
        name="post-contacts-failed-creation-test"
        description="Verify Salesforce business rejection during Contact creation">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce Contact Creation Failure"
                processor="salesforce:create">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Create Salesforce Contact"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[{
                            successful: false,
                            items: [
                                {
                                    exception: {
                                        localizedMessage:
                                            'Email is not in the correct format'
                                    }
                                }
                            ]
                        }]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Invalid Contact Creation Request">

                <munit:payload
                    mediaType="application/json"
                    value="#[output application/json
---
{
    firstName: 'Jane',
    lastName: 'Smith',
    email: 'INVALID_EMAIL',
    accountId: '001000000000001AAA'
}]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Post Contacts Flow"
                name="post:\contacts:application\json:salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Contact Creation Status Failed"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('failed')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Creation Failure Message"
                expression="#[payload.message]"
                is="#[MunitTools::equalTo(
                    'Email is not in the correct format'
                )]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Contact Creation Called Once"
                processor="salesforce:create"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Create Salesforce Contact"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


    <!-- ========================================================= -->
