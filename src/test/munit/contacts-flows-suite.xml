    <!-- ========================================================= -->
    <!-- TEST 07: GET CONTACT BY EMAIL SUCCESS                     -->
    <!-- ========================================================= -->

    <munit:test
        name="get-contacts-by-email-success-test"
        description="Verify successful Salesforce Contact query by email">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce Contact Email Query Success"
                processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Query Salesforce Contact By Email"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[[
                            {
                                Id: '003000000000001AAA',
                                FirstName: 'John',
                                LastName: 'Doe',
                                Email: 'john.doe@example.com',
                                AccountId: '001000000000001AAA'
                            }
                        ]]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Existing Contact Email">

                <munit:attributes
                    value="#[{
                        uriParams: {
                            email: 'john.doe@example.com'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Get Contact By Email Flow"
                name="get:\contacts\email\(email):salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Email Search Status Success"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Data Is Not Null"
                expression="#[payload.data]"
                is="#[MunitTools::notNullValue()]"/>

            <munit-tools:assert-that
                doc:name="Assert One Contact Returned"
                expression="#[sizeOf(payload.data)]"
                is="#[MunitTools::equalTo(1)]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Contact ID"
                expression="#[payload.data[0].contactId]"
                is="#[MunitTools::equalTo('003000000000001AAA')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Contact First Name"
                expression="#[payload.data[0].firstName]"
                is="#[MunitTools::equalTo('John')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Contact Last Name"
                expression="#[payload.data[0].lastName]"
                is="#[MunitTools::equalTo('Doe')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Contact Email"
                expression="#[payload.data[0].email]"
                is="#[MunitTools::equalTo('john.doe@example.com')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Contact Account ID"
                expression="#[payload.data[0].accountId]"
                is="#[MunitTools::equalTo('001000000000001AAA')]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Contact Email Query Called Once"
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Query Salesforce Contact By Email"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


