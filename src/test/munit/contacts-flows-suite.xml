    </munit:test>


    <!-- ========================================================= -->
    <!-- TEST 04: GET CONTACT BY ID SUCCESS                        -->
    <!-- ========================================================= -->

    <munit:test
        name="get-contacts-by-id-success-test"
        description="Verify successful Salesforce Contact retrieval by ID">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce Contact Retrieval Success"
                processor="salesforce:retrieve">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Retrieve Salesforce Contact By ID"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[[
                            {
                                Id: '003000000000001AAA',
                                FirstName: 'John',
                                LastName: 'Doe',
                                Email: 'john.doe@example.com',
                                AccountId: '001000000000001AAA'
                            }
                        ]]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Valid Contact ID">

                <munit:attributes
                    value="#[{
                        uriParams: {
                            id: '003000000000001AAA'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Get Contact By ID Flow"
                name="get:\contacts\(id):salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Contact Retrieval Status Success"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Data Is Not Null"
                expression="#[payload.data]"
                is="#[MunitTools::notNullValue()]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact ID"
                expression="#[payload.data.contactId]"
                is="#[MunitTools::equalTo('003000000000001AAA')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact First Name"
                expression="#[payload.data.firstName]"
                is="#[MunitTools::equalTo('John')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Last Name"
                expression="#[payload.data.lastName]"
                is="#[MunitTools::equalTo('Doe')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Email"
                expression="#[payload.data.email]"
                is="#[MunitTools::equalTo('john.doe@example.com')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Account ID"
                expression="#[payload.data.accountId]"
                is="#[MunitTools::equalTo('001000000000001AAA')]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Contact Retrieval Called Once"
                processor="salesforce:retrieve"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Retrieve Salesforce Contact By ID"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


    <!-- ========================================================= -->
    <!-- TEST 05: GET CONTACT BY ID NOT FOUND                      -->
    <!-- ========================================================= -->

    <munit:test
        name="get-contacts-by-id-not-found-test"
        description="Verify empty Salesforce retrieval returns Contact not found">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Empty Salesforce Contact Retrieval"
                processor="salesforce:retrieve">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Retrieve Salesforce Contact By ID"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[[]]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Nonexistent Contact ID">

                <munit:attributes
                    value="#[{
                        uriParams: {
                            id: '003000000000999AAA'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Get Contact By ID Flow"
                name="get:\contacts\(id):salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Contact Retrieval Status Error"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('error')]"/>

            <munit-tools:assert-that
                doc:name="Assert Contact Not Found Message"
                expression="#[payload.message]"
                is="#[MunitTools::equalTo(
                    'Contact not found with ID: 003000000000999AAA'
                )]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Contact Retrieval Called Once"
                processor="salesforce:retrieve"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Retrieve Salesforce Contact By ID"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


