    <!-- ==========================================================================
         TEST 7 — Successful Contact Query by Email (happy path)
         Mock  : salesforce:query returns a non-empty List of Contact Maps
         Flow  : get:\contacts\email\(email):salesforce-sys-api-config
         Expect: payload.status            = "success"
                 payload.data is not null
                 payload.data contains exactly one record
                 payload.data[0].contactId = "0035000001ContactABC"
                 payload.data[0].firstName = "John"
                 payload.data[0].lastName  = "Doe"
                 payload.data[0].email     = "john.doe@example.com"
                 payload.data[0].accountId = "0015000001XxxXXXABC"
                 vars.httpStatus is null (global error handler never fired)
                 salesforce:query called exactly once
         ========================================================================== -->
    <munit:test name="get-contacts-by-email-success-test"
                doc:id="cnt70001-7001-7001-7001-700000000001"
                description="Verify a valid email with matching contacts returns status=success and correctly mapped data array">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:query — returns contact records"
                                   doc:id="cnt70002-7002-7002-7002-700000000002"
                                   processor="salesforce:query">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Query"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[[
                        {
                            Id        : "0035000001ContactABC",
                            FirstName : "John",
                            LastName  : "Doe",
                            Email     : "john.doe@example.com",
                            AccountId : "0015000001XxxXXXABC"
                        }
                    ]]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — valid email with matching contacts"
                             doc:id="cnt70003-7003-7003-7003-700000000003">
                <munit:attributes value='#[{
                    uriParams: {
