<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="contacts-flows-suite.xml"/>

    <!-- ==========================================================================
         TEST 1 — Successful Contact Creation (happy path)
         Mock  : salesforce:create returns { successful: true,
                                             items[0].payload.success: true,
                                             items[0].id: "0035000001ContactABC" }
         Flow  : post:\contacts:application\json:salesforce-sys-api-config
         Expect: payload.status  = "success"
                 payload.message = "Contact created successfully"
                 payload.id      = "0035000001ContactABC"
                 vars.httpStatus is null (global error handler never fired)
                 salesforce:create called exactly once
         ========================================================================== -->
    <munit:test name="post-contacts-success-test"
                doc:id="cnt10001-1001-1001-1001-100000000001"
                description="Verify a valid contact creation returns status=success, the new contact id, and no HTTP error status">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:create — success"
                                   doc:id="cnt10002-1002-1002-1002-100000000002"
                                   processor="salesforce:create">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{
                        successful: true,
                        items: [
                            {
                                payload: {
                                    success: true
                                },
                                id: "0035000001ContactABC"
                            }
                        ]
                    }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — valid firstName, lastName, email, accountId"
                             doc:id="cnt10003-1003-1003-1003-100000000003">
                <munit:payload mediaType="application/java" value='#[{
                    firstName: "John",
                    lastName: "Doe",
                    email: "john.doe@example.com",
                    accountId: "0015000001XxxXXXABC"
                }]'/>
            </munit:set-event>
            <flow-ref doc:name="Flow Reference — post contacts"
                      doc:id="cnt10004-1004-1004-1004-100000000004"
                      name="post:\contacts:application\json:salesforce-sys-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="Assert payload.status is success"
                                     doc:id="cnt10005-1005-1005-1005-100000000005"
                                     expression="#[payload.status]"
                                     is='#[MunitTools::equalTo("success")]'/>
            <munit-tools:assert-that doc:name="Assert payload.message is Contact created successfully"
                                     doc:id="cnt10006-1006-1006-1006-100000000006"
                                     expression="#[payload.message]"
                                     is='#[MunitTools::equalTo("Contact created successfully")]'/>
            <munit-tools:assert-that doc:name="Assert payload.id echoes the new Salesforce contact id"
                                     doc:id="cnt10007-1007-1007-1007-100000000007"
                                     expression="#[payload.id]"
                                     is='#[MunitTools::equalTo("0035000001ContactABC")]'/>
            <munit-tools:assert-that doc:name="Assert vars.httpStatus is null (no error handler fired)"
                                     doc:id="cnt10008-1008-1008-1008-100000000008"
                                     expression="#[vars.httpStatus default null]"
                                     is='#[MunitTools::nullValue()]'/>
            <munit-tools:verify-call doc:name="Verify salesforce:create was called exactly once"
                                     doc:id="cnt10009-1009-1009-1009-100000000009"
                                     processor="salesforce:create"
                                     times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

    <!-- ==========================================================================
         TEST 2 — Salesforce Business-Level Creation Failure
         Mock  : salesforce:create returns { successful: false } with localizedMessage.
                 Simulates Salesforce rejecting the creation (e.g. duplicate email,
                 invalid AccountId) without raising a Mule connector error.
         Flow  : post:\contacts:application\json:salesforce-sys-api-config
         Expect: payload.status  = "failed"
                 payload.message = rejection reason from localizedMessage
                 vars.httpStatus is null (no Mule error — global error handler NOT invoked)
                 salesforce:create called exactly once
         ========================================================================== -->
    <munit:test name="post-contacts-failed-creation-test"
                doc:id="cnt20001-2001-2001-2001-200000000001"
                description="Verify a Salesforce business-level rejection on contact create returns status=failed and the rejection message">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:create — Salesforce rejects creation"
                                   doc:id="cnt20002-2002-2002-2002-200000000002"
                                   processor="salesforce:create">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[{
                        successful: false,
                        items: [
                            {
                                exception: {
                                    localizedMessage: "Email is not in the correct format"
                                }
                            }
                        ]
                    }]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — invalid email to trigger business rejection"
                             doc:id="cnt20003-2003-2003-2003-200000000003">
                <munit:payload mediaType="application/java" value='#[{
                    firstName: "Jane",
                    lastName: "Smith",
                    email: "INVALID_EMAIL",
                    accountId: "0015000001XxxXXXABC"
                }]'/>
            </munit:set-event>
            <flow-ref doc:name="Flow Reference — post contacts"
                      doc:id="cnt20004-2004-2004-2004-200000000004"
                      name="post:\contacts:application\json:salesforce-sys-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="Assert payload.status is failed"
                                     doc:id="cnt20005-2005-2005-2005-200000000005"
                                     expression="#[payload.status]"
                                     is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert payload.message contains the rejection reason"
                                     doc:id="cnt20006-2006-2006-2006-200000000006"
                                     expression="#[payload.message]"
                                     is='#[MunitTools::equalTo("Email is not in the correct format")]'/>
            <munit-tools:assert-that doc:name="Assert vars.httpStatus is null (no Mule error — error handler not invoked)"
                                     doc:id="cnt20007-2007-2007-2007-200000000007"
                                     expression="#[vars.httpStatus default null]"
                                     is='#[MunitTools::nullValue()]'/>
            <munit-tools:verify-call doc:name="Verify salesforce:create was called exactly once"
                                     doc:id="cnt20008-2008-2008-2008-200000000008"
                                     processor="salesforce:create"
                                     times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

    <!-- ==========================================================================
         TEST 3 — Salesforce Connectivity Error on Contact Creation
         Mock  : salesforce:create throws SALESFORCE:CONNECTIVITY (connector-level error)
         Flow  : post:\contacts:application\json:salesforce-sys-api-config
         Handler: global_error_handler on-error-propagate SALESFORCE:CONNECTIVITY
                  sets vars.httpStatus = 503, calls common_error_handler, re-propagates
         MUnit : expectedErrorType="SALESFORCE:CONNECTIVITY" — validation runs against
                 event state after error-handler processors complete.
         Expect: error type    = SALESFORCE:CONNECTIVITY
                 vars.httpStatus  = 503
                 payload.status   = "failed"
                 payload.statusCode = 503
                 salesforce:create called exactly once
         ========================================================================== -->
    <munit:test name="post-contacts-connectivity-error-test"
                doc:id="cnt30001-3001-3001-3001-300000000001"
                description="Verify SALESFORCE:CONNECTIVITY on contact create triggers global error handler, sets httpStatus=503, and returns failed payload"
                expectedErrorType="SALESFORCE:CONNECTIVITY">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:create — throw SALESFORCE:CONNECTIVITY"
                                   doc:id="cnt30002-3002-3002-3002-300000000002"
                                   processor="salesforce:create">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="SALESFORCE:CONNECTIVITY"
                                       doc:id="cnt30003-3003-3003-3003-300000000003"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — valid contact fields, connectivity will fail at connector"
                             doc:id="cnt30004-3004-3004-3004-300000000004">
                <munit:payload mediaType="application/java" value='#[{
                    firstName: "John",
                    lastName: "Doe",
                    email: "john.doe@example.com",
                    accountId: "0015000001XxxXXXABC"
                }]'/>
            </munit:set-event>
            <flow-ref doc:name="Flow Reference — post contacts"
                      doc:id="cnt30005-3005-3005-3005-300000000005"
                      name="post:\contacts:application\json:salesforce-sys-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="Assert vars.httpStatus is 503 (set by global error handler)"
                                     doc:id="cnt30006-3006-3006-3006-300000000006"
                                     expression="#[vars.httpStatus default null]"
                                     is='#[MunitTools::equalTo(503)]'/>
            <munit-tools:assert-that doc:name="Assert payload.status is failed (set by common_error_handler)"
                                     doc:id="cnt30007-3007-3007-3007-300000000007"
                                     expression="#[payload.status]"
                                     is='#[MunitTools::equalTo("failed")]'/>
            <munit-tools:assert-that doc:name="Assert payload.statusCode is 503"
                                     doc:id="cnt30008-3008-3008-3008-300000000008"
                                     expression="#[payload.statusCode]"
                                     is='#[MunitTools::equalTo(503)]'/>
            <munit-tools:verify-call doc:name="Verify salesforce:create was called exactly once"
                                     doc:id="cnt30009-3009-3009-3009-300000000009"
                                     processor="salesforce:create"
                                     times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

    <!-- ==========================================================================
         TEST 4 — Successful Contact Retrieval by ID (happy path)
         Mock  : salesforce:retrieve returns a list containing one Contact record
                 with Id, FirstName, LastName, Email, AccountId populated.
         Flow  : get:\contacts\(id):salesforce-sys-api-config
         Expect: payload.status         = "success"
                 payload.data.contactId = "0035000001ContactABC"
                 payload.data.firstName = "John"
                 payload.data.lastName  = "Doe"
                 payload.data.email     = "john.doe@example.com"
                 payload.data.accountId = "0015000001XxxXXXABC"
                 vars.httpStatus is null (global error handler never fired)
                 salesforce:retrieve called exactly once
         ========================================================================== -->
    <munit:test name="get-contacts-by-id-success-test"
                doc:id="cnt40001-4001-4001-4001-400000000001"
                description="Verify a valid contact ID returns status=success with all mapped data fields and no HTTP error status">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:retrieve — returns one contact record"
                                   doc:id="cnt40002-4002-4002-4002-400000000002"
                                   processor="salesforce:retrieve">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve Contact"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value='#[[
                        {
                            Id        : "0035000001ContactABC",
                            FirstName : "John",
                            LastName  : "Doe",
                            Email     : "john.doe@example.com",
                            AccountId : "0015000001XxxXXXABC"
                        }
                    ]]'/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — valid contact ID in uriParams"
                             doc:id="cnt40003-4003-4003-4003-400000000003">
                <munit:attributes value='#[{
                    uriParams: {
                        id: "0035000001ContactABC"
                    }
                }]'/>
            </munit:set-event>
            <flow-ref doc:name="Flow Reference — get contact by id"
                      doc:id="cnt40004-4004-4004-4004-400000000004"
                      name="get:\contacts\(id):salesforce-sys-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="Assert payload.status is success"
                                     doc:id="cnt40005-4005-4005-4005-400000000005"
                                     expression="#[payload.status]"
                                     is='#[MunitTools::equalTo("success")]'/>
            <munit-tools:assert-that doc:name="Assert payload.data is not null"
                                     doc:id="cnt40006-4006-4006-4006-400000000006"
                                     expression="#[payload.data]"
                                     is='#[MunitTools::notNullValue()]'/>
            <munit-tools:assert-that doc:name="Assert payload.data.contactId is mapped from Salesforce Id"
                                     doc:id="cnt40007-4007-4007-4007-400000000007"
                                     expression="#[payload.data.contactId]"
                                     is='#[MunitTools::equalTo("0035000001ContactABC")]'/>
            <munit-tools:assert-that doc:name="Assert payload.data.firstName is mapped from FirstName"
                                     doc:id="cnt40008-4008-4008-4008-400000000008"
                                     expression="#[payload.data.firstName]"
                                     is='#[MunitTools::equalTo("John")]'/>
            <munit-tools:assert-that doc:name="Assert payload.data.lastName is mapped from LastName"
                                     doc:id="cnt40009-4009-4009-4009-400000000009"
                                     expression="#[payload.data.lastName]"
                                     is='#[MunitTools::equalTo("Doe")]'/>
            <munit-tools:assert-that doc:name="Assert payload.data.email is mapped from Email"
                                     doc:id="cnt40010-4010-4010-4010-400000000010"
                                     expression="#[payload.data.email]"
                                     is='#[MunitTools::equalTo("john.doe@example.com")]'/>
            <munit-tools:assert-that doc:name="Assert payload.data.accountId is mapped from AccountId"
                                     doc:id="cnt40011-4011-4011-4011-400000000011"
                                     expression="#[payload.data.accountId]"
                                     is='#[MunitTools::equalTo("0015000001XxxXXXABC")]'/>
            <munit-tools:assert-that doc:name="Assert vars.httpStatus is null (no error handler fired)"
                                     doc:id="cnt40012-4012-4012-4012-400000000012"
                                     expression="#[vars.httpStatus default null]"
                                     is='#[MunitTools::nullValue()]'/>
            <munit-tools:verify-call doc:name="Verify salesforce:retrieve was called exactly once"
                                     doc:id="cnt40013-4013-4013-4013-400000000013"
                                     processor="salesforce:retrieve"
                                     times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve Contact"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

    <!-- ==========================================================================
         TEST 5 — Contact Not Found by ID (empty retrieve result)
         Mock  : salesforce:retrieve returns an empty list []
                 Simulates a valid-format ID that has no Contact record in Salesforce.
         Flow  : get:\contacts\(id):salesforce-sys-api-config
         Expect: payload.status  = "error"
                 payload.message = "Contact not found with ID: 0035000001NotFoundXX"
                 vars.httpStatus is null (isEmpty branch — no Mule error raised)
                 salesforce:retrieve called exactly once
         ========================================================================== -->
    <munit:test name="get-contacts-by-id-not-found-test"
                doc:id="cnt50001-5001-5001-5001-500000000001"
                description="Verify a contact ID with no matching record returns status=error with a descriptive message and no HTTP error status">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock salesforce:retrieve — returns empty list"
                                   doc:id="cnt50002-5002-5002-5002-500000000002"
                                   processor="salesforce:retrieve">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve Contact"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[[]]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event doc:name="Set Input — contact ID with no matching record"
                             doc:id="cnt50003-5003-5003-5003-500000000003">
                <munit:attributes value='#[{
                    uriParams: {
                        id: "0035000001NotFoundXX"
                    }
                }]'/>
            </munit:set-event>
            <flow-ref doc:name="Flow Reference — get contact by id"
                      doc:id="cnt50004-5004-5004-5004-500000000004"
                      name="get:\contacts\(id):salesforce-sys-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="Assert payload.status is error"
                                     doc:id="cnt50005-5005-5005-5005-500000000005"
                                     expression="#[payload.status]"
                                     is='#[MunitTools::equalTo("error")]'/>
            <munit-tools:assert-that doc:name="Assert payload.message reports the missing contact ID"
                                     doc:id="cnt50006-5006-5006-5006-500000000006"
                                     expression="#[payload.message]"
                                     is='#[MunitTools::equalTo("Contact not found with ID: 0035000001NotFoundXX")]'/>
            <munit-tools:assert-that doc:name="Assert vars.httpStatus is null (empty-list branch — no Mule error raised)"
                                     doc:id="cnt50007-5007-5007-5007-500000000007"
                                     expression="#[vars.httpStatus default null]"
                                     is='#[MunitTools::nullValue()]'/>
            <munit-tools:verify-call doc:name="Verify salesforce:retrieve was called exactly once"
                                     doc:id="cnt50008-5008-5008-5008-500000000008"
                                     processor="salesforce:retrieve"
                                     times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Retrieve Contact"/>
