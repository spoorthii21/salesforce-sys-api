        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="accounts-flows-suite.xml"/>


    <!-- ============================================================
         TEST 01: GET ACCOUNT BY NAME - SUCCESS
         ============================================================ -->

    <munit:test
            name="get-accounts-by-name-success-test"
            description="Verify a matching account name returns successfully mapped account data">

        <munit:behavior>

            <munit-tools:mock-when
                    doc:name="Mock Salesforce Query Success"
                    processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                            attributeName="doc:name"
                            whereValue="Query"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                            mediaType="application/java"
                            value="#[[
                                {
                                    Id: '001000000000001AAA',
                                    Name: 'Acme Corp',
                                    'Type' : 'Customer'
                                }
                            ]]"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Matching Account Name">
                <munit:attributes
                        value="#[{
                            uriParams: {
                                name: 'Acme Corp'
                            }
                        }]"/>
            </munit:set-event>

            <flow-ref
                    doc:name="Call Get Accounts By Name Flow"
                    name="get:\accounts\name\(name):salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                    doc:name="Assert Status Success"
                    expression="#[payload.status]"
                    is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                    doc:name="Assert Data Is Not Null"
                    expression="#[payload.data]"
                    is="#[MunitTools::notNullValue()]"/>

            <munit-tools:assert-that
                    doc:name="Assert One Account Returned"
                    expression="#[sizeOf(payload.data)]"
                    is="#[MunitTools::equalTo(1)]"/>

            <munit-tools:assert-that
                    doc:name="Assert Account ID"
                    expression="#[payload.data[0].id]"
                    is="#[MunitTools::equalTo('001000000000001AAA')]"/>

            <munit-tools:assert-that
                    doc:name="Assert Account Name"
                    expression="#[payload.data[0].name]"
                    is="#[MunitTools::equalTo('Acme Corp')]"/>

            <munit-tools:assert-that
                    doc:name="Assert Account Type"
                    expression="#[payload.data[0].'type']"
                    is="#[MunitTools::equalTo('Customer')]"/>

            <munit-tools:assert-that
                    doc:name="Assert HTTP Status Is Null"
                    expression="#[vars.httpStatus default null]"
                    is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                    doc:name="Verify Query Called Once"
                    processor="salesforce:query"
                    times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                            attributeName="doc:name"
                            whereValue="Query"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


