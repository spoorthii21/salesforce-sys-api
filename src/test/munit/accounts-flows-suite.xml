    <!-- ============================================================
         TEST 09: POST ACCOUNT - SUCCESS
         ============================================================ -->

    <munit:test
            name="post-accounts-success-test"
            description="Verify successful Salesforce account creation">

        <munit:behavior>

            <munit-tools:mock-when
                    doc:name="Mock Salesforce Create Success"
                    processor="salesforce:create">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                            attributeName="doc:name"
                            whereValue="Create Account"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                            mediaType="application/java"
                            value="#[{
                                id: null,
                                items: [
                                    {
                                        id: '0015000001XxxXXXABC',
                                        statusCode: null,
                                        message: null,
                                        payload: {
                                            success: true,
                                            errors: []
                                        },
                                        successful: true
                                    }
                                ],
                                successful: true
                            }]"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Valid Account Input">
				<munit:payload value="#[output application/json&#10;---&#10;{&#10;                            name: 'Acme Corporation',&#10;                            &quot;type&quot;: 'Customer'&#10;                        }]" mediaType="application/json" />
            </munit:set-event>

            <flow-ref
                    doc:name="Call Post Accounts Flow"
                    name="post:\accounts:application\json:salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                    doc:name="Assert Status Success"
                    expression="#[payload.status]"
                    is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                    doc:name="Assert Creation Message"
                    expression="#[payload.message]"
                    is="#[MunitTools::equalTo('Account created successfully')]"/>

            <munit-tools:assert-that
                    doc:name="Assert Created Account ID"
                    expression="#[payload.id]"
                    is="#[MunitTools::equalTo('0015000001XxxXXXABC')]"/>

            <munit-tools:assert-that
                    doc:name="Assert HTTP Status Is Null"
                    expression="#[vars.httpStatus default null]"
                    is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                    doc:name="Verify Create Called Once"
                    processor="salesforce:create"
                    times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                            attributeName="doc:name"
                            whereValue="Create Account"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


