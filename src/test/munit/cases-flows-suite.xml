    <munit:config name="cases-flows-suite.xml"/>

    <!-- ========================================================= -->
    <!-- TEST 01: PATCH CASE SUCCESS                               -->
    <!-- ========================================================= -->

    <munit:test
        name="patch-cases-success-test"
        description="Verify successful case update">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Salesforce Case Update Success"
                processor="salesforce:update">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Update Salesforce Case"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[{
                            successful: true,
                            items: [
                                {
                                    payload: {
                                        success: true
                                    }
                                }
                            ]
                        }]"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Valid Case Update Input">

                <munit:payload
                    mediaType="application/java"
                    value="#[{
                        status: 'Closed',
                        priority: 'High'
                    }]"/>

                <munit:attributes
                    value="#[{
                        uriParams: {
                            caseId: '5008W00000DCaseXYZ'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Patch Case Flow"
                name="patch:\cases\(caseId):application\json:salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Case Update Status Success"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Updated Case ID"
                expression="#[payload.caseId]"
                is="#[MunitTools::equalTo('5008W00000DCaseXYZ')]"/>

            <munit-tools:assert-that
                doc:name="Assert Case Update Success Message"
                expression="#[payload.message]"
                is="#[MunitTools::equalTo('Case updated successfully')]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Case Update Called Once"
                processor="salesforce:update"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Update Salesforce Case"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

    <!-- ========================================================= -->
    <!-- TEST 02: PATCH CASE BUSINESS FAILURE                      -->
