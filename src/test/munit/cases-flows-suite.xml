    <!-- ========================================================= -->
    <!-- TEST 04: GET CASES BY CONTACT SUCCESS                     -->
    <!-- ========================================================= -->

    <munit:test
        name="get-cases-by-contact-success-test"
        description="Verify cases are returned for a contact">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock Case Query Success"
                processor="salesforce:query">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Query Cases By Contact ID"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        mediaType="application/java"
                        value="#[[
                            {
                                Id: '5003000000D8cuBAAR',
                                Subject: 'Test Case Subject',
                                Description: 'Test case description',
                                Priority: 'High',
                                Status: 'Open',
                                ContactId: '0030000000XyZABC'
                            }
                        ]]"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Valid Contact ID">

                <munit:attributes
                    value="#[{
                        uriParams: {
                            contactId: '0030000000XyZABC'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call Get Cases By Contact Flow"
                name="get:\cases\customer\(contactId):salesforce-sys-api-config"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Case Search Status Success"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('success')]"/>

            <munit-tools:assert-that
                doc:name="Assert Case Data Is Not Null"
                expression="#[payload.data]"
                is="#[MunitTools::notNullValue()]"/>

            <munit-tools:assert-that
                doc:name="Assert One Case Returned"
                expression="#[sizeOf(payload.data)]"
                is="#[MunitTools::equalTo(1)]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case ID"
                expression="#[payload.data[0].caseId]"
                is="#[MunitTools::equalTo('5003000000D8cuBAAR')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case Subject"
                expression="#[payload.data[0].subject]"
                is="#[MunitTools::equalTo('Test Case Subject')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case Description"
                expression="#[payload.data[0].description]"
                is="#[MunitTools::equalTo('Test case description')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case Priority"
                expression="#[payload.data[0].priority]"
                is="#[MunitTools::equalTo('High')]"/>

            <munit-tools:assert-that
                doc:name="Assert Returned Case Status"
                expression="#[payload.data[0].status]"
                is="#[MunitTools::equalTo('Open')]"/>

            <munit-tools:assert-that
                doc:name="Assert HTTP Status Is Null"
                expression="#[vars.httpStatus default null]"
                is="#[MunitTools::nullValue()]"/>

            <munit-tools:verify-call
                doc:name="Verify Case Query Called Once"
                processor="salesforce:query"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Query Cases By Contact ID"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

