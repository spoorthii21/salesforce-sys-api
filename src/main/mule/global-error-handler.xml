<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Default global error-handler configuration -->
    <configuration
        doc:name="Configure Default Global Error Handler"
        doc:id="4b77c8e5-7d95-421a-86eb-df35e6a40818"
        defaultErrorHandler-ref="global_error_handler"/>

    <!-- Global error handler -->
    <error-handler
        name="global_error_handler">

        <!-- APIKIT:BAD_REQUEST -->
        <on-error-propagate
            type="APIKIT:BAD_REQUEST"
            doc:name="Handle APIKit Bad Request">

            <set-variable
                variableName="httpStatus"
                value="#[400]"
                doc:name="Set Bad Request Status 400"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Bad Request Error Response"/>

        </on-error-propagate>

        <!-- APIKIT:NOT_FOUND -->
        <on-error-propagate
            type="APIKIT:NOT_FOUND"
            doc:name="Handle APIKit Not Found">

            <set-variable
                variableName="httpStatus"
                value="#[404]"
                doc:name="Set Not Found Status 404"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Not Found Error Response"/>

        </on-error-propagate>

        <!-- APIKIT:METHOD_NOT_ALLOWED -->
        <on-error-propagate
            type="APIKIT:METHOD_NOT_ALLOWED"
            doc:name="Handle APIKit Method Not Allowed">

            <set-variable
                variableName="httpStatus"
                value="#[405]"
                doc:name="Set Method Not Allowed Status 405"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Method Not Allowed Response"/>

        </on-error-propagate>

        <!-- APIKIT:NOT_ACCEPTABLE -->
        <on-error-propagate
            type="APIKIT:NOT_ACCEPTABLE"
            doc:name="Handle APIKit Not Acceptable">

            <set-variable
                variableName="httpStatus"
                value="#[406]"
                doc:name="Set Not Acceptable Status 406"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Not Acceptable Error Response"/>

        </on-error-propagate>

        <!-- APIKIT:UNSUPPORTED_MEDIA_TYPE -->
        <on-error-propagate
            type="APIKIT:UNSUPPORTED_MEDIA_TYPE"
            doc:name="Handle APIKit Unsupported Media Type">

            <set-variable
                variableName="httpStatus"
                value="#[415]"
                doc:name="Set Unsupported Media Type Status 415"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Unsupported Media Type Response"/>

        </on-error-propagate>

        <!-- APIKIT:NOT_IMPLEMENTED -->
        <on-error-propagate
            type="APIKIT:NOT_IMPLEMENTED"
            doc:name="Handle APIKit Not Implemented">

            <set-variable
                variableName="httpStatus"
                value="#[501]"
                doc:name="Set Not Implemented Status 501"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Not Implemented Error Response"/>

        </on-error-propagate>

        <!-- SALESFORCE:INVALID_INPUT -->
        <on-error-propagate
            type="SALESFORCE:INVALID_INPUT"
            doc:name="Handle Salesforce Invalid Input">

            <set-variable
                variableName="httpStatus"
                value="#[400]"
                doc:name="Set Salesforce Invalid Input Status 400"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Salesforce Invalid Input Response"/>

        </on-error-propagate>

        <!-- SALESFORCE:CONNECTIVITY -->
        <on-error-propagate
            type="SALESFORCE:CONNECTIVITY"
            doc:name="Handle Salesforce Connectivity Failure">

            <set-variable
                variableName="httpStatus"
                value="#[503]"
                doc:name="Set Service Unavailable Status 503"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Salesforce Connectivity Response"/>

        </on-error-propagate>

        <!-- SALESFORCE:TIMEOUT -->
        <on-error-propagate
            type="SALESFORCE:TIMEOUT"
            doc:name="Handle Salesforce Timeout">

            <set-variable
                variableName="httpStatus"
                value="#[504]"
                doc:name="Set Gateway Timeout Status 504"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Salesforce Timeout Response"/>

        </on-error-propagate>

        <!-- Catch all remaining errors -->
        <on-error-propagate
            type="ANY"
            doc:name="Handle Unexpected System Error">

            <set-variable
                variableName="httpStatus"
                value="#[500]"
                doc:name="Set Internal Server Error Status 500"/>

            <flow-ref
                name="common_error_handler"
                doc:name="Build Internal Server Error Response"/>

        </on-error-propagate>

    </error-handler>

    <!-- Common error-response builder -->
    <sub-flow name="common_error_handler">

        <logger
            level="ERROR"
            doc:name="Log Error Details With Correlation ID"
            message='CorrelationId: #[correlationId] | ErrorType: #[error.errorType.identifier] | Message: #[error.description]'/>

        <ee:transform
            doc:name="Build Standard Error Response">

            <ee:message>

                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "failed",
    statusCode: vars.httpStatus,
    correlationId: correlationId,
    errorType: error.errorType.identifier,
    message: error.description
}
                ]]></ee:set-payload>

            </ee:message>

        </ee:transform>

    </sub-flow>

</mule>