<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/salesforce
        http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">

    <!-- PATCH /cases/{caseId} -->
    <flow name="patch:\cases\(caseId):application\json:salesforce-sys-api-config">

        <logger
            level="INFO"
            doc:name="Log Case Update Start"
            message="Updating Case: #[attributes.uriParams.caseId]"/>

        <set-variable
            value="#[attributes.uriParams.caseId]"
            doc:name="Set Case ID Variable"
            doc:id="6ce4e0c2-4406-4065-974c-00284b0ee503"
            variableName="caseId"/>

        <ee:transform
            doc:name="Build Salesforce Case Update Request"
            doc:id="b6b78fc7-7f99-4a95-9b5a-993c897c256f">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/java
---
[
    {
        Id: vars.caseId,
        Status: payload.status,
        Priority: payload.priority
    }
]
                ]]></ee:set-payload>
            </ee:message>

        </ee:transform>

        <salesforce:update
            type="Case"
            doc:name="Update Salesforce Case"
            doc:id="5e758f9c-3b1b-4733-bfad-26222ede6173"
            config-ref="Salesforce_Config"/>

        <ee:transform
            doc:name="Transform Case Update Response"
            doc:id="9e1e9d46-c873-42a8-9e85-90aa3ba34080">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
if (
    payload.successful == true and
    (payload.items[0].payload.success default false) == true
)
{
    "status": "success",
    "message": "Case updated successfully",
    "caseId": vars.caseId
}
else
{
    "status": "failed",
    "message":
        payload.items[0].exception.localizedMessage
            default "Salesforce rejected Case update."
}
                ]]></ee:set-payload>
            </ee:message>

            <ee:variables>
            </ee:variables>

        </ee:transform>

        <logger
            level="INFO"
            doc:name="Log Case Update Completion"
            doc:id="7d4b733c-2f2a-4409-96ba-48935b0063c9"
            message="Case Updated Successfully"/>

    </flow>


    <!-- GET /cases/customer/{contactId} -->
    <flow name="get:\cases\customer\(contactId):salesforce-sys-api-config">

        <logger
            level="INFO"
            doc:name="Log Customer Case Search Start"
            message="Fetching cases for contact: #[attributes.uriParams.contactId]"/>

        <set-variable
            value="#[attributes.uriParams.contactId]"
            doc:name="Set Contact ID Variable"
            doc:id="90ffb775-e83d-4d7d-b1f9-218b7864cc6c"
            variableName="contactId"/>

        <salesforce:query
            doc:name="Query Cases By Contact ID"
            doc:id="b9e2520f-8153-44a4-9eea-55b007285c00"
            config-ref="Salesforce_Config">

            <salesforce:salesforce-query><![CDATA[
SELECT Id, Subject, Description, Priority, Status, ContactId
FROM Case
WHERE ContactId = ':contactId'
            ]]></salesforce:salesforce-query>

            <salesforce:parameters><![CDATA[
#[output application/java
---
{
    "contactId": vars.contactId
}]
            ]]></salesforce:parameters>

        </salesforce:query>

        <ee:transform
            doc:name="Transform Customer Case Search Response"
            doc:id="b6b20900-3aee-4663-bef0-d6f8f466619e">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
if (isEmpty(payload))
{
    "status": "error",
    "message":
        "No cases found for contact ID: " ++
        (vars.contactId default "")
}
else
{
    "status": "success",
    "data": payload map (item) -> {
        "caseId": item.Id,
        "subject": item.Subject,
        "description": item.Description,
        "priority": item.Priority,
        "status": item.Status
    }
}
                ]]></ee:set-payload>
            </ee:message>

            <ee:variables>
            </ee:variables>

        </ee:transform>

        <logger
            level="INFO"
            doc:name="Log Customer Case Search Completion"
            doc:id="0edea239-8213-4142-9f64-b76c8065a3da"
            message="Cases Retrieved Successfully"/>

    </flow>


    <!-- POST /cases -->
    <flow name="post:\cases:application\json:salesforce-sys-api-config">

        <logger
            level="INFO"
            doc:name="Log Case Creation Start"
            message="Creating Case"/>

        <ee:transform
            doc:name="Build Salesforce Case Creation Request"
            doc:id="ad0dae2f-bbb9-41ec-9545-411c902cb68d">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/java
---
[
    {
        ContactId: payload.contactId,
        Subject: payload.subject,
        Description: payload.description,
        Priority: payload.priority,
        Status: "New"
    }
]
                ]]></ee:set-payload>
            </ee:message>

        </ee:transform>

        <salesforce:create
            type="Case"
            doc:name="Create Salesforce Case"
            doc:id="860bebf6-1e7f-4350-b544-87427ac824c0"
            config-ref="Salesforce_Config"/>

        <ee:transform
            doc:name="Transform Case Creation Response"
            doc:id="99d1d2dc-c53d-4ef1-b814-08b906fb0bf6">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
if (
    payload.successful == true and
    (payload.items[0].payload.success default false) == true
)
{
    "status": "success",
    "message": "Case created successfully",
    "id": payload.items[0].id
}
else
{
    "status": "failed",
    "message":
        payload.items[0].exception.localizedMessage
            default "Salesforce rejected Case creation. Check if ContactId exists and Priority is valid."
}
                ]]></ee:set-payload>
            </ee:message>

            <ee:variables>
            </ee:variables>

        </ee:transform>

        <logger
            level="INFO"
            doc:name="Log Case Creation Completion"
            doc:id="b2353131-ed66-45f3-ab1c-47767df6078f"
            message="Case Created Successfully"/>

    </flow>

</mule>