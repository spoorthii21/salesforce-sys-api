<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Mule Application Coordinates                              -->
    <!-- ========================================================= -->

    <groupId>3566f43d-29f6-4a1e-ac94-4be9322c7333</groupId>
    <artifactId>salesforce-sys-api-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>salesforce-sys-api</name>


    <!-- ========================================================= -->
    <!-- Project Properties                                        -->
    <!-- ========================================================= -->

    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <project.reporting.outputEncoding>
            UTF-8
        </project.reporting.outputEncoding>

        <!-- Mule runtime and plugin versions -->
        <app.runtime>4.12.2</app.runtime>
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>
        <munit.version>3.7.3</munit.version>

        <!-- CloudHub 2.0 deployment values -->
        <anypoint.org.id>
            ${env.ANYPOINT_ORG_ID}
        </anypoint.org.id>

        <cloudhub.environment>
            ${env.ANYPOINT_ENVIRONMENT}
        </cloudhub.environment>

        <cloudhub.target>
            ${env.CLOUDHUB_TARGET}
        </cloudhub.target>

        <cloudhub.application.name>
            ${env.SAPI_APPLICATION_NAME}
        </cloudhub.application.name>

        <!-- API Manager instance ID used by Autodiscovery -->
        <api.id>
            ${env.SAPI_API_ID}
        </api.id>

        <!--
            Environment credentials used by the deployed Mule runtime
            to communicate with API Manager.
        -->
        <anypoint.platform.client.id>
            ${env.ANYPOINT_PLATFORM_CLIENT_ID}
        </anypoint.platform.client.id>

        <anypoint.platform.client.secret>
            ${env.ANYPOINT_PLATFORM_CLIENT_SECRET}
        </anypoint.platform.client.secret>

        <!-- Secure Configuration Properties decryption key -->
        <mule.key>
            ${env.MULE_KEY}
        </mule.key>

    </properties>


    <!-- ========================================================= -->
    <!-- Build Configuration                                       -->
    <!-- ========================================================= -->

    <build>

        <plugins>

            <!-- Maven Clean Plugin -->
            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-clean-plugin
                </artifactId>

                <version>3.2.0</version>

            </plugin>


            <!-- ================================================= -->
            <!-- Mule Maven Plugin                                 -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.mule.tools.maven
                </groupId>

                <artifactId>
                    mule-maven-plugin
                </artifactId>

                <version>
                    ${mule.maven.plugin.version}
                </version>

                <extensions>true</extensions>

                <configuration>

                    <classifier>
                        mule-application
                    </classifier>

                    <!-- ========================================= -->
                    <!-- CloudHub 2.0 Deployment                   -->
                    <!-- ========================================= -->

                    <cloudhub2Deployment>

                        <uri>
                            https://anypoint.mulesoft.com
                        </uri>

                        <provider>MC</provider>

                        <!-- Root organization or business group ID -->
                        <businessGroupId>
                            ${anypoint.org.id}
                        </businessGroupId>

                        <!-- Anypoint environment -->
                        <environment>
                            ${cloudhub.environment}
                        </environment>

                        <!-- CloudHub 2.0 shared/private space target -->
                        <target>
                            ${cloudhub.target}
                        </target>

                        <!-- Mule runtime version -->
                        <muleVersion>
                            ${app.runtime}
                        </muleVersion>

                        <!-- Runtime Manager application name -->
                        <applicationName>
                            ${cloudhub.application.name}
                        </applicationName>

                        <!--
                            Connected App credentials used by Maven
                            to authenticate and deploy the application.
                        -->
                        <connectedAppClientId>
                            ${env.CONNECTED_APP_CLIENT_ID}
                        </connectedAppClientId>

                        <connectedAppClientSecret>
                            ${env.CONNECTED_APP_CLIENT_SECRET}
                        </connectedAppClientSecret>

                        <connectedAppGrantType>
                            client_credentials
                        </connectedAppGrantType>

                        <!-- CloudHub 2.0 runtime allocation -->
                        <replicas>1</replicas>
                        <vCores>0.1</vCores>


                        <!-- ===================================== -->
                        <!-- Normal Runtime Properties             -->
                        <!-- ===================================== -->

                        <properties>

                            <!--
                                API Manager instance ID used by:

                                <api-gateway:autodiscovery
                                    apiId="${api.id}"
                                    flowRef="salesforce-sys-api-main"/>
                            -->
                            <api.id>
                                ${api.id}
                            </api.id>

                        </properties>


                        <!-- ===================================== -->
                        <!-- Protected Runtime Properties          -->
                        <!-- ===================================== -->

                        <secureProperties>

                            <!--
                                Platform environment Client ID used
                                by Mule Gateway for API Manager pairing.
                            -->
                            <anypoint.platform.client_id>
                                ${anypoint.platform.client.id}
                            </anypoint.platform.client_id>

                            <!--
                                Platform environment Client Secret used
                                by Mule Gateway for API Manager pairing.
                            -->
                            <anypoint.platform.client_secret>
                                ${anypoint.platform.client.secret}
                            </anypoint.platform.client_secret>

                            <!--
                                Decryption key used by the Mule Secure
                                Configuration Properties module.
                            -->
                            <mule.key>
                                ${mule.key}
                            </mule.key>

                        </secureProperties>

                    </cloudhub2Deployment>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- MUnit Testing and Coverage                        -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    com.mulesoft.munit.tools
                </groupId>

                <artifactId>
                    munit-maven-plugin
                </artifactId>

                <version>
                    ${munit.version}
                </version>

                <executions>

                    <execution>

                        <id>test</id>
                        <phase>test</phase>

                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>

                    </execution>

                </executions>

                <configuration>

                    <coverage>

                        <runCoverage>true</runCoverage>

                        <formats>
                            <format>console</format>
                            <format>html</format>
                        </formats>

                    </coverage>

                </configuration>

            </plugin>

        </plugins>

    </build>


    <!-- ========================================================= -->
    <!-- Anypoint Exchange Publishing                              -->
    <!-- ========================================================= -->

    <distributionManagement>

        <repository>

            <id>
                anypoint-exchange-v3
            </id>

            <name>
                Anypoint Exchange Repository
            </name>

            <url>
                https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven
            </url>

            <layout>default</layout>

        </repository>

    </distributionManagement>


    <!-- ========================================================= -->
    <!-- Mule Application Dependencies                             -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- HTTP Connector -->
        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-http-connector
            </artifactId>

            <version>1.11.3</version>
            <classifier>mule-plugin</classifier>

        </dependency>


        <!-- Sockets Connector -->
        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-sockets-connector
            </artifactId>

            <version>1.2.9</version>
            <classifier>mule-plugin</classifier>

        </dependency>


        <!-- Salesforce System API RAML -->
        <dependency>

            <groupId>
                3566f43d-29f6-4a1e-ac94-4be9322c7333
            </groupId>

            <artifactId>
                salesforce-sys-api
            </artifactId>

            <version>1.0.0</version>
            <classifier>raml</classifier>
            <type>zip</type>

        </dependency>


        <!-- APIKit Module -->
        <dependency>

            <groupId>
                org.mule.modules
            </groupId>

            <artifactId>
                mule-apikit-module
            </artifactId>

            <version>1.12.2</version>
            <classifier>mule-plugin</classifier>

        </dependency>


        <!-- Salesforce Connector -->
        <dependency>

            <groupId>
                com.mulesoft.connectors
            </groupId>

            <artifactId>
                mule-salesforce-connector
            </artifactId>

            <version>12.0.0</version>
            <classifier>mule-plugin</classifier>

        </dependency>


        <!-- MUnit Runner -->
        <dependency>

            <groupId>
                com.mulesoft.munit
            </groupId>

            <artifactId>
                munit-runner
            </artifactId>

            <version>
                ${munit.version}
            </version>

            <classifier>mule-plugin</classifier>
            <scope>test</scope>

        </dependency>


        <!-- MUnit Tools -->
        <dependency>

            <groupId>
                com.mulesoft.munit
            </groupId>

            <artifactId>
                munit-tools
            </artifactId>

            <version>
                ${munit.version}
            </version>

            <classifier>mule-plugin</classifier>
            <scope>test</scope>

        </dependency>


        <!-- DataWeave Assertions -->
        <dependency>

            <groupId>
                org.mule.weave
            </groupId>

            <artifactId>
                assertions
            </artifactId>

            <version>1.2.1</version>
            <scope>test</scope>

        </dependency>


        <!-- Secure Configuration Properties Module -->
        <dependency>

            <groupId>
                com.mulesoft.modules
            </groupId>

            <artifactId>
                mule-secure-configuration-property-module
            </artifactId>

            <version>1.3.2</version>
            <classifier>mule-plugin</classifier>

        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- Maven Repositories                                        -->
    <!-- ========================================================= -->

    <repositories>

        <!-- Anypoint Exchange -->
        <repository>

            <id>
                anypoint-exchange-v3
            </id>

            <name>
                Anypoint Exchange
            </name>

            <url>
                https://maven.anypoint.mulesoft.com/api/v3/maven
            </url>

            <layout>default</layout>

        </repository>


        <!-- MuleSoft Releases -->
        <repository>

            <id>
                mulesoft-releases
            </id>

            <name>
                MuleSoft Releases Repository
            </name>

            <url>
                https://repository.mulesoft.org/nexus/repository/releases/
            </url>

            <layout>default</layout>

        </repository>

    </repositories>


    <!-- ========================================================= -->
    <!-- Maven Plugin Repositories                                 -->
    <!-- ========================================================= -->

    <pluginRepositories>

        <pluginRepository>

            <id>
                mulesoft-releases
            </id>

            <name>
                MuleSoft Releases Repository
            </name>

            <layout>default</layout>

            <url>
                https://repository.mulesoft.org/nexus/repository/releases/
            </url>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>false</enabled>
            </snapshots>

        </pluginRepository>

    </pluginRepositories>

</project>